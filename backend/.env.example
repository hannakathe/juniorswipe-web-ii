# Copy to .env for local runs.  NEVER commit the real .env.
SECRET_KEY=change-me-in-real-deployments
JWT_SECRET=change-me-too
JWT_EXPIRES_SECONDS=3600

# Leave DATABASE_URL empty to use a local SQLite file (no Postgres needed).
# In Docker / Kubernetes this is set to the PostgreSQL service.
DATABASE_URL=

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5501,http://127.0.0.1:5501

HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=1
SEED_ON_STARTUP=true
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=5242880
